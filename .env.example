# Copy to .env on the server. Never put model keys into VITE_* variables.
REVIEW_BIND_IP=127.0.0.1
BRAND_PORT=8080
CREATOR_PORT=8081
REVIEW_TIMEZONE=Asia/Hong_Kong
REVIEW_SCRIPT_OUTPUT_MODE=auto
# CPU speech transcription. First use downloads weights into the persistent volume.
INSTALL_LOCAL_ASR=true
ASR_LANGUAGE=zh
# Only for a gateway that authenticates users and overwrites the matching header.
REVIEW_GATEWAY_TOKEN=
REVIEW_ALLOWED_ORIGINS=
